#!/bin/zsh
# kitmux (split-keys variant): mirrors one tmux session per target as native
# kitty tabs, one tab per tmux window. Each tab is a tmux client attached to a
# helper session grouped with the mirrored session; tmux draws the panes and
# the keys in kitmux.conf drive tmux pane and window commands.
#
# Usage: kitmux [-s SESSION] [TARGET...]
#
# Process layout:
#   kitmux            launcher: validates, prepares each target, starts the bridge
#   kitmux _bridge    background supervisor of one run: opens its OS window in the
#                     shared kitty process (the first run starts it), sorts tabs
#   (loop_main)       one forked control loop per target, a tmux -C client
#   kitmux _tab       runs in every kitty tab: the reconnecting tmux client
#   kitmux _hold      first kitty window of a run's OS window, shown until the
#                     first tab exists
#   kitmux _newtab, _split, _pane, _confirm, _scrollback, _copy, _copylast
#                     key actions

emulate -R zsh
setopt extended_glob no_equals pipe_fail
zmodload zsh/datetime zsh/zselect

# --- constants ----------------------------------------------------------------

typeset -gr SELF=${${(%):-%x}:A}                 # absolute path of this script
typeset -gr OVERLAY_CONF=${SELF:h}/kitmux.conf   # kitty overlay conf with the keys
typeset -gr DEFAULT_SESSION=main
typeset -gr LOCAL_TARGET=local
typeset -gr SESSION_PATTERN='^[A-Za-z0-9_.-]{1,32}$'
typeset -gr SAFE_PATH_PATTERN='^/[A-Za-z0-9_./+@-]*$'  # paths passed through tmux and sh unquoted
typeset -gr LANG_PATTERN='^[A-Za-z0-9_.@-]+$'
typeset -gr FALLBACK_LANG=en_US.UTF-8
typeset -gr HELPER_SEPARATOR=__                  # helper session = SESSION__<window id number>
typeset -gri MIN_TMUX_MAJOR=3 MIN_TMUX_MINOR=2
typeset -gri SSH_ERROR_STATUS=255                # ssh's own exit status for transport failures

typeset -gr RUNTIME_PARENT=kitmux-$UID           # stable per-user dir: the shared kitty's socket and the runs' sort flags
typeset -gr SOCKET_NAME=kitty.sock
typeset -gri SOCKET_PATH_MAX=100                 # macOS limit for unix socket paths is 104
typeset -gr SORT_FLAG_PREFIX=sort                # sort.<bridge pid> in the runtime dir: non-empty when a loop wants a re-sort
typeset -gr SSH_FILE_PREFIX=ssh                  # ssh.<bridge pid> in the runtime dir: "TARGET OPTIONS" lines for the key actions
# kitmux's own ssh options. They come after the user's, so a user -o setting
# wins (ssh keeps the first value it gets for an option).
typeset -gra SSH_OPTS=(-o ControlMaster=auto -o "ControlPath=$HOME/.ssh/kitmux-%C" -o ControlPersist=10m
  -o ServerAliveInterval=10 -o ServerAliveCountMax=3)
typeset -gr SSH_VALUE_FLAGS=BbcDEeFIiJLlmOoPpQRSWw  # ssh flags that take a value (OpenSSH 10.3)
typeset -gr INSTANCE_GROUP_PREFIX=kitmux         # kitty --instance-group = prefix-<checksum of the runtime dir>
typeset -gri KITTY_START_TIMEOUT=10              # seconds to wait for kitty's socket
typeset -gri TICK_CS=20                          # bridge supervision tick, centiseconds
typeset -gri SORT_INTERVAL=2                     # seconds between unconditional re-sorts
typeset -gri RELIST_INTERVAL=2                   # seconds between safety re-lists of tmux windows
typeset -gr BURST_QUIET=0.05                     # seconds of silence that end a notification burst
typeset -gri CTL_POLL=1                          # seconds per read while waiting for a reply
typeset -gri CTL_TIMEOUT=45                      # give up on a reply after this long (> ssh keepalive)
typeset -gri CONTINUUM_TICK=60                   # seconds between continuum save ticks
typeset -gri RECONNECT_MIN=1 RECONNECT_MAX=15    # backoff bounds in seconds
typeset -gri LOOP_RESTART_DELAY=2                # seconds before restarting a crashed loop
typeset -gri NEWTAB_WAIT_CS=500                  # how long _newtab waits for its tab, centiseconds
typeset -gri NEWTAB_POLL_CS=5
typeset -gr COPY_BUFFER=kitmux-copy              # tmux buffer holding copied text until it is piped out, never one of the user's
typeset -gr COPY_STATE='#{selection_present}|#{pane_in_mode}|#{mouse_any_flag}|#{pane_current_command}'
typeset -gr CLAUDE_COMMAND='(claude|<->.<->.<->)'  # Claude Code's process name, a version for the native install
# Claude Code's copy key: super+c in the kitty keyboard protocol, ESC [ 99 ; 9 u,
# as hex for send-keys -H. With no selection it does nothing; ctrl+c would arm
# Claude Code's exit, and other programs read these bytes as Esc and keys.
typeset -gra CLAUDE_COPY_KEY=(1b 5b 39 39 3b 39 75)
# Copy-last-output key. COPYLAST_POS is a tmux format for the absolute line
# number (0 = oldest history line) of the copy-mode cursor.
typeset -gr COPYLAST_POS='#{e|-:#{e|+:#{history_size},#{copy_cursor_y}},#{scroll_position}}'
typeset -gr COPYLAST_NO_MARKS='no OSC 133 marks'
typeset -gr COPYLAST_NO_OUTPUT='last command printed nothing'
typeset -gr COPYLAST_FAILED='copy of last output failed (tmux 3.5+ needed)'
typeset -gri ORDER_TARGET_DIGITS=4 ORDER_INDEX_DIGITS=10

# Exit statuses of a control loop, read by the bridge.
typeset -gri LOOP_SESSION_ENDED=0 LOOP_KITTY_GONE=3

# Session targets are always written "=NAME:". The "=" asks for an exact match
# and the colon ends the session part: without it tmux reads a dot in the name
# as a window.pane separator.
#
# Line formats for tmux listings read over the control channel. Names go last
# because they may contain spaces.
typeset -gr WINDOW_FORMAT='W #{window_id} #{window_index} #{window_name}'
typeset -gr HELPER_FORMAT='S #{window_id} #{session_id} #{session_name}'

# tmux's built-in status-left, which names the session (the helper's own name in
# a tab), and the replacement for helpers: the name of the mirrored session.
typeset -gr DEFAULT_STATUS_LEFT='[#{session_name}] '
typeset -gr HELPER_STATUS_LEFT='[#{session_group}] '

# POSIX sh run on a target (stdin of `sh -s -- MODE SESSION`) before a control
# client attaches. MODE start: make sure SESSION exists, restoring a cold server
# with tmux-resurrect, and remove helper sessions left by an earlier run.
# MODE resume: only report whether SESSION still exists; when it does not, also
# remove the helpers, which would otherwise keep its windows alive.
# Prints `gone`, `error <text>` or `ok`, preceded by `save <path>` when the
# tmux-continuum save script exists.
typeset -gr CONNECT_SCRIPT='
mode=$1 session=$2
fail() { printf "error %s\n" "$*"; exit 0; }
safe_path() { case $1 in /*) ;; *) return 1 ;; esac; case $1 in *[!A-Za-z0-9_./+@-]*) return 1 ;; esac; }
plugins_dir() {
  p=$(tmux show-environment -g TMUX_PLUGIN_MANAGER_PATH 2>/dev/null) || p=
  case $p in TMUX_PLUGIN_MANAGER_PATH=*) p=${p#TMUX_PLUGIN_MANAGER_PATH=} ;; *) p= ;; esac
  [ -n "$p" ] || p=$HOME/.tmux/plugins/
  printf %s "${p%/}"
}
drop_helpers() {
  tmux list-sessions -F "#{session_name}" 2>/dev/null | while IFS= read -r name; do
    rest=${name#"$session"__}
    [ "$rest" != "$name" ] || continue
    case $rest in ""|*[!0-9]*) continue ;; esac
    tmux kill-session -t "=$name:" 2>/dev/null
  done
}
new_session() {
  out=$(tmux new-session -d -s "$session" 2>&1) && return 0
  case $out in *"duplicate session"*) return 0 ;; esac
  fail "$out"
}
command -v tmux >/dev/null 2>&1 || fail "tmux not found"
cold=0
if ! out=$(tmux list-sessions -F "#{session_name}" 2>&1); then
  case $out in
    *"no server running"*|*"error connecting"*) cold=1 ;;
    *) fail "$out" ;;
  esac
fi
if [ "$cold" = 1 ]; then
  [ "$mode" = start ] || { echo gone; exit 0; }
  new_session
  restore=$(plugins_dir)/tmux-resurrect/scripts/restore.sh
  if [ -f "$restore" ] && safe_path "$restore"; then
    tmux run-shell "$restore" >/dev/null 2>&1
  fi
elif ! tmux has-session -t "=$session:" 2>/dev/null; then
  # SESSION was killed while its helpers still hold the windows: end them too.
  [ "$mode" = start ] || { drop_helpers; echo gone; exit 0; }
  new_session
fi
[ "$mode" = start ] && drop_helpers
save=$(plugins_dir)/tmux-continuum/scripts/continuum_save.sh
if [ -f "$save" ] && safe_path "$save"; then printf "save %s\n" "$save"; fi
echo ok
'

# sh -c script for a tab: $0 is the helper session target. Falls back to a
# stock TERM when the target has no terminfo entry for kitty's (on a tty,
# every tmux command refuses an unknown TERM). Attaches only to a helper that
# exists: attach-session starts a tmux server when none runs, and on a
# rebooted host that server would load the config and let tmux-continuum
# restore the session behind kitmux's back.
typeset -gr ATTACH_SCRIPT='infocmp "$TERM" >/dev/null 2>&1 || TERM=xterm-256color; export TERM; tmux has-session -t "$0" 2>/dev/null || exit 1; exec tmux attach-session -t "$0"'

# jq filter: the kitmux tab windows of one target ($t) in OS window $o, one line
# each: kitty tab id, kitty window id, tmux window id, sort key, 1 if it is the
# active tab, tab title.
typeset -gr JQ_TARGET_TABS='
.[] | select(.id == $o) | .tabs[] | . as $tab | .windows[]
| select(.user_vars.kitmux_target == $t and (.user_vars.kitmux_window // "") != "" and (.user_vars.kitmux_overlay // "") == "")
| "\($tab.id) \(.id) \(.user_vars.kitmux_window) \(.user_vars.kitmux_order // "-") \(if $tab.is_active then 1 else 0 end) \($tab.title)"'

# jq filter: the tabs of OS window $o in tab bar order, one line each: tab id,
# 1 if it is the active tab, and the sort key of its kitmux window ("-" for
# other tabs).
typeset -gr JQ_OS_TABS='
.[] | select(.id == $o) | .tabs[]
| "\(.id) \(if .is_active then 1 else 0 end) \([.windows[] | select((.user_vars.kitmux_window // "") != "" and (.user_vars.kitmux_overlay // "") == "") | .user_vars.kitmux_order // empty][0] // "-")"'

# jq filter: the state of OS window $o, one line, nothing when it is gone: 1 if
# it has the OS focus (else 0), 1 if it is kitty's active OS window (the one
# goto_tab and move_tab_* act on), the 1-based position of its active tab, and
# the id of a kitty window in it (a kitmux tab window when there is one).
typeset -gr JQ_OS_STATE='
.[] | select(.id == $o)
| ([.tabs[].windows[] | select((.user_vars.kitmux_window // "") != "" and (.user_vars.kitmux_overlay // "") == "") | .id][0] // .tabs[0].windows[0].id) as $anchor
| "\(if .is_focused then 1 else 0 end) \(if .is_active then 1 else 0 end) \(([.tabs[].is_active] | index(true) // 0) + 1) \($anchor)"'

# jq filter: the id of the OS window holding a window tagged with run $r.
typeset -gr JQ_OS_OF_RUN='
[.[] | select(any(.tabs[].windows[]; .user_vars.kitmux_run == $r)) | .id][0] // empty'

# jq filter: the id of the OS window holding kitty window $w.
typeset -gr JQ_OS_OF_WINDOW='
[.[] | select(any(.tabs[].windows[]; .id == $w)) | .id][0] // empty'

# jq filter: the ids of all tabs of OS window $o.
typeset -gr JQ_OS_TAB_IDS='
.[] | select(.id == $o) | .tabs[].id'

# jq filter: every kitmux tab window, one line each: run (bridge pid), target,
# session, kitty tab id.
typeset -gr JQ_OPEN_TABS='
.[] | .tabs[] | . as $tab | .windows[]
| select((.user_vars.kitmux_window // "") != "" and (.user_vars.kitmux_overlay // "") == "")
| "\(.user_vars.kitmux_run // 0) \(.user_vars.kitmux_target) \(.user_vars.kitmux_session) \($tab.id)"'

# jq filter: the kitmux vars of the only window in the listing, one per line:
# target, tmux window id, session, overlay flag, run, tab title.
typeset -gr JQ_WINDOW_VARS='
.[0].tabs[0] | .title as $title | .windows[0].user_vars
| (.kitmux_target // ""), (.kitmux_window // ""), (.kitmux_session // ""), (.kitmux_overlay // ""), (.kitmux_run // ""), $title'

# jq filter: tab id of the kitmux window of target $t showing tmux window $w.
typeset -gr JQ_TAB_OF_WINDOW='
[.[] | .tabs[] | select(any(.windows[]; .user_vars.kitmux_target == $t and .user_vars.kitmux_window == $w and (.user_vars.kitmux_overlay // "") == "")) | .id][0] // empty'

# jq filter: tab id of the kitmux tab of OS window $o that sorts first.
typeset -gr JQ_FIRST_TAB='
[.[] | select(.id == $o) | .tabs[] | {id, order: ([.windows[] | .user_vars.kitmux_order // empty][0])} | select(.order != null)] | sort_by(.order) | .[0].id // empty'

# --- small helpers ------------------------------------------------------------

# Prints an error for the user and exits. Used by the launcher only.
die() {
  print -r -u2 -- "kitmux: $*"
  exit 1
}

# Writes one timestamped line to stderr, which is the log file in the bridge.
log() {
  print -r -u2 -- "$(strftime '%Y-%m-%d %H:%M:%S' $EPOCHSECONDS) [$$] $*"
}

# Succeeds when $1 is a usable session name.
valid_session() {
  [[ $1 =~ $SESSION_PATTERN && $1 != . && $1 != .. ]]
}

# Succeeds when $1 is a usable target: not an option, no spaces, and nothing
# clean_name would strip (control, bidi and zero-width characters).
valid_target() {
  [[ -n $1 && $1 != -* && $1 != *' '* ]] || return 1
  clean_name "$1"
  [[ $REPLY == $1 ]]
}

# Sets REPLY to $1 without control characters and without bidi and zero-width
# characters. Works on UTF-8 bytes so the result does not depend on the locale.
clean_name() {
  emulate -L zsh
  setopt extended_glob no_multibyte
  local s=$1
  s=${s//[$'\x01'-$'\x1f'$'\x7f']/}            # C0 controls and DEL
  s=${s//$'\xc2'[$'\x80'-$'\x9f']/}            # C1 controls U+0080..U+009F
  s=${s//$'\xd8\x9c'/}                         # U+061C arabic letter mark
  s=${s//$'\xe2\x80'[$'\x8b'-$'\x8f']/}        # U+200B..U+200F zero-width, LRM, RLM
  s=${s//$'\xe2\x80'[$'\xaa'-$'\xae']/}        # U+202A..U+202E bidi embeddings and overrides
  s=${s//$'\xe2\x81'[$'\xa0'-$'\xa9']/}        # U+2060..U+2069 word joiner, bidi isolates
  s=${s//$'\xef\xbb\xbf'/}                     # U+FEFF zero-width no-break space
  REPLY=$s
}

# Sets REPLY to the kitty tab title for a tmux window: target, index, name.
tab_title() {
  local target=$1 index=$2 prefix=
  [[ $target == $LOCAL_TARGET ]] || prefix=${target##*@}:
  clean_name "$3"
  REPLY=${prefix}tmux-${index}${REPLY:+ $REPLY}
}

# Succeeds when the control-mode line $1 is a %session-window-changed
# notification, and sets REPLY to "SESSION_ID WINDOW_ID" (for example "$3 @7").
parse_window_change() {
  [[ $1 =~ '^%session-window-changed (\$[0-9]+) (@[0-9]+)$' ]] || return 1
  REPLY="$match[1] $match[2]"
}

# Sets REPLY to the status-left a helper needs when the mirrored session's
# status-left is $1: the helper form when $1 is tmux's default (which would show
# the helper's name), empty when the user set their own, which the helper keeps
# inheriting.
helper_status_left() {
  REPLY=
  [[ $1 == $DEFAULT_STATUS_LEFT ]] && REPLY=$HELPER_STATUS_LEFT
}

# Sets REPLY to the fixed-width sort key of a tab: target position on the
# command line (0-based), then tmux window index. Plain string order sorts it.
order_key() {
  REPLY=${(l:ORDER_TARGET_DIGITS::0:)1}${(l:ORDER_INDEX_DIGITS::0:)2}
}

# Succeeds when the `tmux -V` output $1 names a version kitmux supports.
# Builds without a number (master, openbsd-x.y) are accepted.
tmux_version_ok() {
  [[ $1 =~ '([0-9]+)\.([0-9]+)' ]] || return 0
  local -i major=$match[1] minor=$match[2]
  (( major > MIN_TMUX_MAJOR || (major == MIN_TMUX_MAJOR && minor >= MIN_TMUX_MINOR) ))
}

# Sets reply to the moves that sort the managed tabs of one OS window. Args are
# the tabs in their current order: a sort key for a kitmux tab, "-" for any
# other tab. Each move is "FROM TO" with FROM > TO (1-based positions at the
# time of the move): the tab goes towards the front and the tabs in between
# shift back by one. Other tabs end where they started.
sort_plan() {
  local -a keys slots wanted
  local -i i p q u n=$#
  keys=("$@")
  reply=()
  for (( i = 1; i <= n; i++ )); do
    [[ $keys[i] == - ]] || { slots+=($i); wanted+=($keys[i]); }
  done
  wanted=(${(o)wanted})
  for (( i = 1; i <= $#slots; i++ )); do
    p=$slots[i]
    [[ $keys[p] == $wanted[i] ]] && continue
    for (( q = p + 1; q <= n; q++ )); do
      [[ $keys[q] == $wanted[i] ]] && break
    done
    reply+=("$q $p")
    keys=($keys[1,p-1] $keys[q] $keys[p,q-1] $keys[q+1,n])
    # The move pushed every tab in p+1..q one place back; return foreign tabs.
    for (( u = p + 2; u <= q; u++ )); do
      [[ $keys[u] == - ]] || continue
      reply+=("$u $((u - 1))")
      keys[u]=$keys[u-1]
      keys[u-1]=-
    done
  done
}

# Sets REPLY to the kitty instance group for runtime dir $1. Every kitmux run
# that uses the same dir joins the same kitty process, and a run with another dir
# (another user, or a different TMPDIR) never touches it.
instance_group_for() {
  local sum
  sum=$(cksum <<< "$1") || return 1
  REPLY=$INSTANCE_GROUP_PREFIX-${sum%% *}
}

# Succeeds when one of the lines "TARGET SESSION TAB" after the first two args
# shows session $1 of target $2, and sets REPLY to that line's kitty tab id.
find_open_tab() {
  local session=$1 target=$2 line t s tab
  shift 2
  for line in "$@"; do
    IFS=' ' read -r t s tab <<< "$line"
    [[ $t == $target && $s == $session ]] && { REPLY=$tab; return 0 }
  done
  return 1
}

# --- running commands on a target ---------------------------------------------

# The user's ssh options for each ssh target, the words after it on the
# launcher's command line, quoted and joined (empty for none).
typeset -gA target_ssh

# Sets up the globals every target command needs: the ssh command and the
# locale tmux runs under (resurrect saves nothing without a UTF-8 locale).
init_target_env() {
  typeset -ga ssh_cmd
  ssh_cmd=(${=KITMUX_SSH:-ssh})
  typeset -g tmux_lang=${LANG:-$FALLBACK_LANG}
  [[ $tmux_lang =~ $LANG_PATTERN ]] || tmux_lang=$FALLBACK_LANG
}

# Splits the launcher's words after its own options into the targets (set in
# reply) and each target's ssh options (set in target_ssh): the words from a
# target up to the next one go to ssh for it. A word starting with - is an
# option. If one of SSH_VALUE_FLAGS ends it, it takes the next word as its value
# (-p 2222), unless the value is attached (-p2222). Fails with a message in REPLY.
parse_targets() {
  local word flags target=
  local -i i
  reply=()
  target_ssh=()
  for (( i = 1; i <= $#; i++ )); do
    word=$argv[i]
    if [[ $word != -* ]]; then
      target=$word
      reply+=($target)
      continue
    fi
    if [[ -z $target || $target == $LOCAL_TARGET ]]; then
      REPLY="ssh option '$word' must follow an ssh target"
      return 1
    fi
    [[ $word == -s ]] && { REPLY="-s goes before the targets"; return 1 }
    target_ssh[$target]+=" ${(qq)word}"
    flags=${word#-}
    while [[ -n $flags ]]; do
      if [[ $SSH_VALUE_FLAGS == *$flags[1]* ]]; then
        if [[ -z $flags[2,-1] ]]; then
          (( i < $# )) || { REPLY="ssh option '$word' needs a value"; return 1 }
          (( i++ ))
          target_ssh[$target]+=" ${(qq)argv[i]}"
        fi
        break
      fi
      flags=$flags[2,-1]
    done
  done
}

# Loads the ssh options of run $1 for target $2 into target_ssh from the file
# its bridge wrote. Key actions use it: the run and target come from kitty user
# vars, which a program in the pane can set, so the options themselves must not.
load_target_ssh() {
  local file=${${kitty_sock#unix:}:h}/$SSH_FILE_PREFIX.$1 target opts
  [[ $1 == <-> && -r $file ]] || return 0
  while IFS=' ' read -r target opts; do
    [[ $target == $2 ]] && target_ssh[$2]=$opts
  done < $file
}

# Sets REPLY to a POSIX shell command line: the given words, each single-quoted,
# run with the tmux locale. `env` keeps it valid in non-POSIX login shells.
shell_line() {
  REPLY="env LANG=$tmux_lang ${(j: :)${(@qq)@}}"
}

# Runs the shell command line $2 on target $1. Extra args are ssh options.
# stdin, stdout and stderr pass through.
on_target() {
  local target=$1 line=$2
  shift 2
  if [[ $target == $LOCAL_TARGET ]]; then
    sh -c "$line"
  else
    $ssh_cmd ${(@Q)${(z)target_ssh[$target]}} $SSH_OPTS "$@" -- "$target" "$line"
  fi
}

# Runs `tmux ARGS...` on target $1. Every argument is a constant or validated.
tmux_on() {
  local target=$1
  shift
  shell_line tmux "$@"
  on_target "$target" "$REPLY"
}

# Runs CONNECT_SCRIPT on target $1 in mode $2 for session $3 and prints its
# report. Returns ssh's status when the transport failed.
connect_target() {
  shell_line sh -s -- "$2" "$3"
  on_target "$1" "$REPLY" <<< "$CONNECT_SCRIPT"
}

# --- kitty remote control -----------------------------------------------------

# Runs a kitty remote control command against this instance's socket.
kt() {
  kitten @ --to "$kitty_sock" "$@"
}

# Reads this run's OS window (os_window) from the kt ls listing $1 and sets
# os_focused, os_active, os_position and os_anchor, see JQ_OS_STATE. Fails when
# the OS window is gone.
os_state() {
  local line
  typeset -g os_focused os_active os_position os_anchor
  line=$(jq -r --argjson o $os_window "$JQ_OS_STATE" <<< "$1") || return 1
  [[ -n $line ]] || return 1
  IFS=' ' read -r os_focused os_active os_position os_anchor <<< "$line"
}

# Sets REPLY to the id of the OS window holding the windows of run $1, empty
# while the run has none.
os_window_of_run() {
  REPLY=$(kt ls 2>/dev/null | jq -r --arg r "$1" "$JQ_OS_OF_RUN")
  [[ -n $REPLY ]]
}

# Closes every tab of this run's OS window, which closes the window. Remote
# control does not ask for confirmation, unlike kitty's own close and quit
# actions, which ask while a tab's client is still running. One close-tab
# closes them all, so a tab's own process can call it: it dies with its tab.
close_os_window() {
  local -a tabs
  tabs=(${(f)"$(kt ls 2>/dev/null | jq -r --argjson o $os_window "$JQ_OS_TAB_IDS")"})
  (( $#tabs )) && kt close-tab --match "${(j: or :)${(@)tabs/#/id:}}"
}

# Detaches the run whose OS window holds this kitty window ($KITTY_WINDOW_ID)
# by closing that OS window, the same as closing it by hand: its bridge sees it
# gone and drops the helper sessions. Runs in a tab, where kitty sets
# KITTY_LISTEN_ON to its socket.
detach_run() {
  [[ $KITTY_WINDOW_ID == <-> ]] || return 1
  typeset -g kitty_sock=$KITTY_LISTEN_ON os_window
  os_window=$(kt ls 2>/dev/null | jq -r --argjson w $KITTY_WINDOW_ID "$JQ_OS_OF_WINDOW")
  [[ -n $os_window ]] && close_os_window
}

# Looks up the kitmux user vars of kitty window $1 and sets win_target,
# win_tmux, win_session, win_overlay and win_title, and loads the target's ssh
# options. Fails for other windows.
window_vars() {
  local out
  local -a fields
  out=$(kt ls --match "id:$1" 2>/dev/null | jq -r "$JQ_WINDOW_VARS") || return 1
  fields=("${(@f)out}")
  typeset -g win_target=$fields[1] win_tmux=$fields[2] win_session=$fields[3] win_overlay=$fields[4] win_title=$fields[6]
  load_target_ssh "$fields[5]" "$win_target"
  [[ -n $win_target && $win_tmux == @<-> ]] && valid_session "$win_session"
}

# --- control loop (one process per target) ------------------------------------

# Starts the tmux control-mode client as this process's coproc and reads the
# reply to its attach. Sets ctl_pid, ctl_in and ctl_out.
ctl_open() {
  shell_line tmux -C attach-session -t "=$session:" -f no-output,ignore-size
  if [[ $target == $LOCAL_TARGET ]]; then
    coproc sh -c "$REPLY"
  else
    coproc $ssh_cmd ${(@Q)${(z)target_ssh[$target]}} $SSH_OPTS -- "$target" "$REPLY"
  fi
  typeset -g ctl_pid=$!
  typeset -g ctl_in ctl_out
  exec {ctl_in}<&p {ctl_out}>&p
  ctl_reply
}

# Stops the control client and releases its descriptors.
ctl_close() {
  [[ -n ${ctl_pid:-} ]] || return 0
  exec {ctl_in}<&- {ctl_out}>&-
  kill $ctl_pid 2>/dev/null
  wait $ctl_pid 2>/dev/null
  ctl_pid=
}

# Reads up to the end of the next command reply and collects its output lines
# in reply. Returns 0 on %end, 1 on %error, 2 when the client is gone or stuck.
# A notification seen on the way goes through note_event.
ctl_reply() {
  local line number=
  local -i waited=0
  reply=()
  while true; do
    if IFS= read -r -t $CTL_POLL -u $ctl_in line; then
      waited=0
      if [[ -n $number ]]; then
        case $line in
          ("%end "<->" $number "*) return 0 ;;
          ("%error "<->" $number "*) return 1 ;;
          (*) reply+=("$line") ;;
        esac
      else
        case $line in
          ("%begin "*) number=${${(s: :)line}[3]} ;;
          ("%exit"*) return 2 ;;
          (*) note_event "$line" ;;
        esac
      fi
    else
      kill -0 $ctl_pid 2>/dev/null || return 2
      (( (waited += CTL_POLL) < CTL_TIMEOUT )) || return 2
    fi
  done
}

# Records the control-mode notification $1: tmux changed, so list again, and a
# %session-window-changed is queued in wc_changes for reconcile to act on.
note_event() {
  ctl_dirty=1
  parse_window_change "$1" && wc_changes+=("$REPLY")
}

# Sends the tmux command $1 over the control channel; see ctl_reply.
ctl_cmd() {
  print -r -u $ctl_out -- "$1" 2>/dev/null || return 2
  ctl_reply
}

# Creates the helper session $1 showing tmux window $2: grouped with the
# session, the normal tmux status line (naming the mirrored session, not the
# helper, unless the user set their own status-left), the user's mouse option,
# and a bell only for its own window. A grouped session holds every window, and
# the default bell-action would ring this tab for a bell in any of them.
make_helper() {
  local -a current
  ctl_cmd "new-session -d -t '=$session:' -s '$1'"
  if ctl_cmd "show-options -Av -t '=$session:' status-left"; then
    current=("${reply[@]}")
    helper_status_left "${(F)current}"
    [[ -n $REPLY ]] && ctl_cmd "set-option -t '=$1:' status-left '$REPLY'"
  fi
  ctl_cmd "set-option -t '=$1:' bell-action current"
  ctl_cmd "select-window -t '=$1:$2'"
}

# Focuses the kitty tab of tmux window $2 on target $1. Fails when there is no
# such tab (yet).
focus_window_tab() {
  local tab
  tab=$(kt ls 2>/dev/null | jq -r --arg t "$1" --arg w "$2" "$JQ_TAB_OF_WINDOW")
  [[ -n $tab ]] && kt focus-tab --match "id:$tab"
}

# After a failed kitty command: LOOP_KITTY_GONE when this run's OS window is
# gone, else 1 so that the control loop starts over with a fresh listing.
kitty_failure() {
  os_state "$(kt ls 2>/dev/null)" && return 1
  return $LOOP_KITTY_GONE
}

# Brings kitty in line with tmux for this target: one helper session and one
# tab per window, current titles and sort keys, no helpers for dead windows.
# A helper whose current window changed because someone switched windows in its
# tab (next-window, a window number, the window tree, new-window) puts the tab
# back on its own window and focuses the tab of the window that was selected.
# Only the tabs of this run's OS window count. Returns 1 when the control
# channel failed, LOOP_KITTY_GONE when kitty or this run's OS window is gone.
reconcile() {
  local line tag window index name helper title order active listing ktab kwin sid event switch_to= active_window=
  local -a windows keep_focus events
  local -A helper_window helper_of_sid tab_of kwin_of order_of title_of live switched
  local -i changed=0

  ctl_cmd "list-windows -t '=$session:' -F '$WINDOW_FORMAT'" || return 1
  windows=("${reply[@]}")
  ctl_cmd "list-sessions -F '$HELPER_FORMAT'" || return 1
  ctl_dirty=0   # anything tmux reports from here on is newer than these listings
  events=("${wc_changes[@]}")
  wc_changes=()
  for line in "${reply[@]}"; do
    IFS=' ' read -r tag window sid name <<< "$line"
    if [[ $tag == S && $name == ${session}${HELPER_SEPARATOR}<-> ]]; then
      helper_window[$name]=$window
      helper_of_sid[$sid]=$name
    fi
  done
  # Only a window change tmux reported counts as a switch: tmux also moves a
  # helper to another window by itself (swap, renumber), which is no focus request.
  for event in $events; do
    [[ -n $helper_of_sid[${event%% *}] ]] && switched[$helper_of_sid[${event%% *}]]=1
  done

  listing=$(kt ls 2>/dev/null) || return $LOOP_KITTY_GONE
  os_state "$listing" || return $LOOP_KITTY_GONE
  listing=$(jq -r --arg t "$target" --argjson o $os_window "$JQ_TARGET_TABS" <<< "$listing")
  for line in "${(@f)listing}"; do
    [[ -n $line ]] || continue
    IFS=' ' read -r ktab kwin window order active title <<< "$line"
    (( active )) && active_window=$window
    tab_of[$window]=$ktab
    kwin_of[$window]=$kwin
    order_of[$window]=$order
    title_of[$window]=$title
  done

  for line in "${windows[@]}"; do
    IFS=' ' read -r tag window index name <<< "$line"
    [[ $tag == W && $window == @<-> ]] || continue
    live[$window]=1
    helper=${session}${HELPER_SEPARATOR}${window#@}
    if (( ! ${+helper_window[$helper]} )); then
      make_helper $helper $window
    elif [[ $helper_window[$helper] != $window ]]; then
      # tmux keeps a grouped session's current window by index, so a swap, a
      # renumber or a kill elsewhere moves this tab off its window. So does
      # next-window typed in the tab. Put it back.
      (( ${+switched[$helper]} )) && switch_to=$helper_window[$helper]
      ctl_cmd "select-window -t '=$helper:$window'"
    fi
    tab_title "$target" $index "$name"
    title=$REPLY
    order_key $target_index $index
    order=$REPLY
    if (( ! ${+tab_of[$window]} )); then
      # --keep-focus raises the OS window, which would pull kitty in front of
      # whatever app the user is in. Without OS focus, let the new tab become
      # active and switch back to the tab that was. goto_tab only reaches kitty's
      # active OS window, so in another one the new tab stays active.
      # --match with a window of this run's OS window puts the tab there
      # (--next-to is ignored for tabs); the new tab's window is the anchor
      # for the next one.
      keep_focus=()
      (( os_focused )) && keep_focus=(--keep-focus)
      os_anchor=$(kt launch --type=tab --match "window_id:$os_anchor" $keep_focus --tab-title "$title" \
        --var "kitmux_target=$target" --var "kitmux_window=$window" \
        --var "kitmux_session=$session" --var "kitmux_order=$order" \
        --var "kitmux_run=$bridge_run" \
        "$SELF" _tab "$session" "$target" "$window" "$target_ssh[$target]") || { kitty_failure; return }
      (( os_focused || ! os_active )) || kt action goto_tab $os_position
      log "$target: opened tab for $window ($title)"
      changed=1
    else
      [[ $title_of[$window] == $title ]] || kt set-tab-title --match "id:$tab_of[$window]" "$title"
      if [[ $order_of[$window] != $order ]]; then
        kt set-user-vars --match "id:$kwin_of[$window]" "kitmux_order=$order"
        changed=1
      fi
    fi
  done

  (( ${+live[$switch_to]} )) && focus_window_tab $target $switch_to

  # A window's alert flags (! in the status line) clear in every session of the
  # group only when some session switches to it, and a helper never does. When
  # the active tab changes, the mirrored session visits the window left behind,
  # seen until now, and ends on the new one. It steps to the new one first, as a
  # switch to its current window clears nothing.
  if [[ -n $active_window && $active_window != $seen_window ]]; then
    if (( ${+live[$seen_window]} )); then
      ctl_cmd "select-window -t '=$session:$active_window'"
      ctl_cmd "select-window -t '=$session:$seen_window'"
    fi
    ctl_cmd "select-window -t '=$session:$active_window'"
    seen_window=$active_window
  fi

  for helper in "${(@k)helper_window}"; do
    # The tab's client exits with its session, and the tab closes after it.
    (( ${+live[@${helper##*${HELPER_SEPARATOR}}]} )) || ctl_cmd "kill-session -t '=$helper:'"
  done

  (( changed )) && print 1 >> $sort_flag
  return 0
}

# Serves one control connection: reconciles on every notification burst and
# every RELIST_INTERVAL, and ticks the continuum save. Returns 1 when the
# connection ended, LOOP_KITTY_GONE when kitty did or the bridge said stop.
serve() {
  local line
  local -i next_save=$(( EPOCHSECONDS + CONTINUUM_TICK ))
  while true; do
    (( stop )) && return $LOOP_KITTY_GONE
    reconcile || return $?
    if (( EPOCHSECONDS >= next_save )); then
      next_save=$(( EPOCHSECONDS + CONTINUUM_TICK ))
      # The tabs' status lines now run continuum's own save too; the tick stays
      # so saves go on when the user's status line does not run it.
      [[ -n $save_script ]] && { ctl_cmd "run-shell -b '$save_script'" || return 1 }
    fi
    if (( ! ctl_dirty )); then
      if ! IFS= read -r -t $RELIST_INTERVAL -u $ctl_in line; then
        kill -0 $ctl_pid 2>/dev/null || return 1
        continue
      fi
      [[ $line == "%exit"* ]] && return 1
      note_event "$line"
    fi
    while IFS= read -r -t $BURST_QUIET -u $ctl_in line; do
      [[ $line == "%exit"* ]] && return 1
      note_event "$line"
    done
  done
}

# Removes this target's helper sessions when kitmux stops, so only the user's
# session is left on the server. Best effort: needs a live control channel.
drop_helpers() {
  local line tag window sid name
  local -a helpers
  [[ -n ${ctl_pid:-} ]] || return 0
  ctl_cmd "list-sessions -F '$HELPER_FORMAT'" || return 0
  for line in "${reply[@]}"; do
    IFS=' ' read -r tag window sid name <<< "$line"
    [[ $tag == S && $name == ${session}${HELPER_SEPARATOR}<-> ]] && helpers+=($name)
  done
  for name in $helpers; do
    ctl_cmd "kill-session -t '=$name:'" || return 0
  done
}

# Control loop for one target. Args: position on the command line, target.
# Uses the globals session, bridge_run, os_window, sort_flag and kitty_sock.
# Reconnects until the session ends (exit LOOP_SESSION_ENDED) or kitty or this
# run's OS window goes away (exit LOOP_KITTY_GONE).
loop_main() {
  typeset -g target_index=$1 target=$2 save_script= ctl_pid=
  typeset -gi ctl_dirty=0 stop=0
  typeset -ga wc_changes=()   # session-window-changed notifications not yet acted on
  typeset -g seen_window=     # tmux window of the last active tab, see reconcile
  local report line
  local -a lines
  local -i rc delay=$RECONNECT_MIN started
  trap '' PIPE HUP
  trap 'stop=1' TERM INT
  while true; do
    report=$(connect_target "$target" resume "$session" 2>&1)
    rc=$?
    save_script=
    lines=("${(@f)report}")
    for line in $lines; do
      [[ $line == "save "* && ${line#save } =~ $SAFE_PATH_PATTERN ]] && save_script=${line#save }
    done
    case $lines[-1] in
      (ok)
        started=$EPOCHSECONDS
        if ctl_open; then
          log "$target: attached to $session"
          delay=$RECONNECT_MIN
          serve
          rc=$?
          if (( rc == LOOP_KITTY_GONE )); then
            drop_helpers
            ctl_close
            return $LOOP_KITTY_GONE
          fi
          log "$target: control connection ended"
        fi
        ctl_close
        # After a connection that held for a while, find out at once whether
        # the session ended; only a client that dies right away waits.
        (( ! stop && EPOCHSECONDS - started >= RECONNECT_MIN )) && continue
        ;;
      (gone)
        log "$target: session $session ended"
        return $LOOP_SESSION_ENDED
        ;;
      (*)
        log "$target: cannot reach tmux (status $rc): $report"
        ;;
    esac
    (( stop )) && return $LOOP_KITTY_GONE
    kt ls >/dev/null 2>&1 || return $LOOP_KITTY_GONE
    sleep $delay
    (( delay = delay * 2 > RECONNECT_MAX ? RECONNECT_MAX : delay * 2 ))
  done
}

# --- bridge (background supervisor) -------------------------------------------

# Puts the kitmux tabs of this run's OS window in sort-key order, leaving other
# tabs where they are. kitty can only move the active tab of its active OS
# window, so a run whose OS window is not the active one sorts once it becomes
# so. Each move first switches to the tab with goto_tab (focus-tab would raise
# the OS window), and the tab that was active is switched back to at the end.
# Fails when kitty or the OS window is gone.
sort_tabs() {
  local listing line tab active key move active_tab=
  local -a tabs keys
  local -i from to
  listing=$(kt ls 2>/dev/null) || return 1
  os_state "$listing" || return 1
  (( os_active )) || return 0
  listing=$(jq -r --argjson o $os_window "$JQ_OS_TABS" <<< "$listing") || return 0
  for line in "${(@f)listing}"; do
    [[ -n $line ]] || continue
    IFS=' ' read -r tab active key <<< "$line"
    tabs+=($tab)
    keys+=($key)
    (( active )) && active_tab=$tab
  done
  sort_plan $keys
  (( $#reply )) || return 0
  log "sorting tabs: ${(j:, :)reply}"
  for move in "${reply[@]}"; do
    from=${move% *} to=${move#* }
    tab=$tabs[from]
    kt action goto_tab $from || return 0
    repeat $(( from - to )) kt action move_tab_backward
    tabs=($tabs[1,to-1] $tab $tabs[to,from-1] $tabs[from+1,-1])
  done
  [[ -n $active_tab ]] && kt action goto_tab ${tabs[(i)$active_tab]}
  return 0
}

# Runs in the background for the life of one kitmux run. Args: runtime dir,
# session, targets. Opens an OS window in the shared kitty process (starting the
# process when this is the first run), starts one control loop per target, keeps
# the tabs of its own OS window sorted, and stops when that OS window is gone.
# Closes the OS window once every target's session has ended. Other runs' OS
# windows and the kitty process itself are left alone.
bridge_main() {
  typeset -g runtime_dir=$1 session=$2 bridge_run=$$ os_window
  shift 2
  typeset -g sort_flag=$runtime_dir/$SORT_FLAG_PREFIX.$bridge_run
  local ssh_file=$runtime_dir/$SSH_FILE_PREFIX.$bridge_run
  local -a targets loop_pids loop_state config
  local group
  local -i i kitty_pid waited=0 last_sort=0 quit_sent=0 rc alive launcher_rc=-1
  local user_conf=${KITTY_CONFIG_DIRECTORY:-$HOME/.config/kitty}/kitty.conf
  # The launcher passes each target followed by its ssh options.
  while (( $# >= 2 )); do
    targets+=($1)
    target_ssh[$1]=$2
    print -r -- "$1 $2"
    shift 2
  done > $ssh_file
  typeset -g kitty_sock=unix:$runtime_dir/$SOCKET_NAME
  trap '' HUP PIPE
  # A kitmux started from inside another kitty must not hand that context on.
  unset KITTY_WINDOW_ID KITTY_PID KITTY_LISTEN_ON KITTY_PUBLIC_KEY
  init_target_env
  instance_group_for $runtime_dir || { log "cannot compute the kitty instance group"; return 1 }
  group=$REPLY

  [[ -r $user_conf ]] && config+=(--config $user_conf)
  config+=(--config $OVERLAY_CONF)
  # A socket left by a kitty that died would stop the next one from listening.
  [[ -S $runtime_dir/$SOCKET_NAME ]] && ! kt ls >/dev/null 2>&1 && rm -f -- $runtime_dir/$SOCKET_NAME
  # With --single-instance the first run becomes the shared kitty process and
  # stays in this job. A later run only asks that process for a new OS window
  # and exits at once (its config options are then ignored). kitty sets
  # KITTY_LISTEN_ON in windows (overlays included) but not for background
  # processes, so the key alias passes the socket itself. Both aliases hold
  # nothing that belongs to one run, so they work in every OS window.
  kitty $config -o allow_remote_control=socket-only \
    -o "action_alias=kitmux_bg launch --type=background --env ${(qq):-KITTY_LISTEN_ON=$kitty_sock} -- ${(qq)SELF}" \
    -o "action_alias=kitmux_overlay launch --type=overlay --var kitmux_overlay=1 -- ${(qq)SELF}" \
    --single-instance --instance-group $group --listen-on $kitty_sock $SELF _hold $bridge_run &
  kitty_pid=$!
  log "started kitty client $kitty_pid for session $session on: $targets"
  # The window _hold opens tags itself with this run's id, which finds the OS window.
  until os_window_of_run $bridge_run; do
    if (( launcher_rc < 0 )) && ! kill -0 $kitty_pid 2>/dev/null; then
      wait $kitty_pid
      launcher_rc=$?
      (( launcher_rc == 0 )) || { log "kitty failed with status $launcher_rc"; rm -f -- $sort_flag $ssh_file; return 1 }
    fi
    if (( (waited += TICK_CS) > KITTY_START_TIMEOUT * 100 )); then
      log "kitty did not open a window"
      rm -f -- $sort_flag $ssh_file
      return 1
    fi
    zselect -t $TICK_CS
  done
  os_window=$REPLY
  log "OS window $os_window"

  trap 'kill $loop_pids 2>/dev/null; wait $loop_pids 2>/dev/null; rm -f -- $sort_flag $ssh_file; exit 0' TERM INT
  for (( i = 1; i <= $#targets; i++ )); do
    loop_main $((i - 1)) $targets[i] &
    loop_pids[i]=${!}   # zsh 5.9 stores a bare $! literally in an array element
    loop_state[i]=running
  done

  while true; do
    alive=0
    for (( i = 1; i <= $#targets; i++ )); do
      [[ $loop_state[i] == running ]] || continue
      if kill -0 $loop_pids[i] 2>/dev/null; then
        alive+=1
        continue
      fi
      wait $loop_pids[i]
      rc=$?
      if (( rc == LOOP_SESSION_ENDED )); then
        loop_state[i]=ended
      elif (( rc == LOOP_KITTY_GONE )); then
        loop_state[i]=stopped
      else
        log "$targets[i]: control loop died with status $rc, restarting"
        sleep $LOOP_RESTART_DELAY
        loop_main $((i - 1)) $targets[i] &
        loop_pids[i]=${!}
        alive+=1
      fi
    done
    if (( ! alive && ! quit_sent )) && [[ ${loop_state[(I)ended]} != 0 ]]; then
      log "no session left on any target, closing the OS window"
      close_os_window
      quit_sent=1
    fi
    if [[ -s $sort_flag ]] || (( EPOCHSECONDS - last_sort >= SORT_INTERVAL )); then
      : > $sort_flag
      last_sort=$EPOCHSECONDS
      sort_tabs || break
    fi
    zselect -t $TICK_CS
  done

  log "OS window $os_window is gone, stopping"
  kill $loop_pids 2>/dev/null
  wait $loop_pids 2>/dev/null
  rm -f -- $sort_flag $ssh_file
}

# --- commands kitty runs ------------------------------------------------------

# First window of a run's OS window: a notice that stays until the first
# kitmux tab exists in that OS window, then focuses the tab that sorts first and
# exits. Arg: the run's id (the bridge pid), which it stamps on its own window so
# the bridge finds the OS window. focus-tab also raises the OS window, which is
# wanted here and only here: the user just started kitmux, and macOS may have
# left the new window in the back.
hold_main() {
  local first os
  typeset -g kitty_sock=$KITTY_LISTEN_ON
  print -r -- "kitmux: opening tmux windows..."
  kt set-user-vars --match "id:$KITTY_WINDOW_ID" "kitmux_run=$1"
  os=$(kt ls --match "id:$KITTY_WINDOW_ID" | jq -r '.[0].id')
  while true; do
    first=$(kt ls 2>/dev/null | jq -r --argjson o $os "$JQ_FIRST_TAB")
    [[ -n $first ]] && break
    zselect -t $TICK_CS
  done
  # Give the control loops a moment to open the rest before choosing.
  zselect -t $TICK_CS
  first=$(kt ls 2>/dev/null | jq -r --argjson o $os "$JQ_FIRST_TAB")
  [[ -n $first ]] && kt focus-tab --match "id:$first"
}

# Runs in a kitty tab. Args: session, target, tmux window id, the target's ssh
# options (see target_ssh). Keeps a tmux client attached to the window's helper
# session, reattaching after a network drop, and returns (closing the tab) once
# the helper or the window is gone. A detached client closes the run's OS window.
tab_main() {
  local session=$1 target=$2 window=$3 out
  local -a windows
  local helper=${session}${HELPER_SEPARATOR}${window#@}
  local -i rc attach_rc delay=$RECONNECT_MIN started
  valid_session "$session" && [[ $window == @<-> ]] || return 1
  target_ssh[$target]=$4
  init_target_env
  while true; do
    started=$EPOCHSECONDS
    shell_line sh -c "$ATTACH_SCRIPT" "=$helper:"
    on_target "$target" "$REPLY" -q -t
    attach_rc=$?
    # Say so before the check below, which hangs for as long as the host does.
    [[ $target != $LOCAL_TARGET ]] && (( attach_rc == SSH_ERROR_STATUS )) &&
      print -r -- "kitmux: reconnecting to ${target##*@}"
    out=$(tmux_on "$target" list-windows -t "=$helper:" -F '#{window_id}' 2>&1)
    rc=$?
    if [[ $target != $LOCAL_TARGET ]] && (( rc == SSH_ERROR_STATUS )); then
      sleep $delay
      (( delay = delay * 2 > RECONNECT_MAX ? RECONNECT_MAX : delay * 2 ))
      continue
    fi
    windows=("${(@f)out}")
    (( rc == 0 && ${windows[(I)$window]} )) || return 0
    # The client ended cleanly and its window lives on, so it was detached
    # (<prefix> d). A killed session also exits 0, but takes the helper along.
    if (( attach_rc == 0 )); then
      detach_run
      return 0
    fi
    delay=$RECONNECT_MIN
    # A client that exits at once (broken terminal) must not spin.
    (( EPOCHSECONDS - started >= RECONNECT_MIN )) || sleep $RECONNECT_MIN
  done
}

# Shared start of the key actions. $1 is the kitty window the key was pressed
# in. Loads its kitmux vars; returns 1 if it is not a kitmux tab window.
key_context() {
  typeset -g kitty_sock=$KITTY_LISTEN_ON
  init_target_env
  window_vars "$1" && [[ -z $win_overlay ]]
}

# New tab key: opens a tmux window in the home directory of the focused tab's
# target and focuses its kitty tab once the control loop has created it. The
# line's trailing -c "$HOME" stays unquoted so the target's own sh expands it
# (the remote user's home over ssh).
newtab_main() {
  local window
  local -i waited=0
  key_context "$1" || return 1
  shell_line tmux new-window -d -P -F '#{window_id}' -t "=$win_session:"
  window=$(on_target "$win_target" "$REPLY"' -c "$HOME"') || return 1
  [[ $window == @<-> ]] || return 1
  while (( waited < NEWTAB_WAIT_CS )); do
    focus_window_tab $win_target $window && return
    zselect -t $NEWTAB_POLL_CS
    waited+=$NEWTAB_POLL_CS
  done
}

# Split keys: $1 is h (side by side) or v (stacked), $2 the kitty window. The
# new pane starts in the focused pane's directory. shell_line single-quotes the
# format, so tmux (not sh) expands #{pane_current_path}. tmux expands it against
# the current pane of the session the target resolves to, and a bare @id may
# resolve to another tab's helper session, so the target names this tab's own
# helper, whose current window is this tab's window.
split_main() {
  [[ $1 == [hv] ]] && key_context "$2" || return 1
  tmux_on "$win_target" split-window -$1 -t "=${win_session}${HELPER_SEPARATOR}${win_tmux#@}:$win_tmux" -c '#{pane_current_path}'
}

# Pane keys: $1 is next or prev (focus that pane) or forward or backward (swap
# the active pane with the next or previous one, and it stays active), $2 the
# kitty window.
pane_main() {
  [[ $1 == (next|prev|forward|backward) ]] && key_context "$2" || return 1
  case $1 in
    (next) tmux_on "$win_target" select-pane -t "$win_tmux.+" ;;
    (prev) tmux_on "$win_target" select-pane -t "$win_tmux.-" ;;
    (forward) tmux_on "$win_target" swap-pane -D -t "$win_tmux" ;;
    (backward) tmux_on "$win_target" swap-pane -U -t "$win_tmux" ;;
  esac
}

# Close keys, run in an overlay: $1 is pane or window, $2 the kitty window
# under the overlay. Asks, and only y or Y sends the kill to tmux. The tab
# closes afterwards because of the tmux event, never from here.
confirm_main() {
  local kind=$1 key question
  local -a kill_cmd
  key_context "$2" || return 1
  case $kind in
    (pane) question="Kill tmux pane in $win_title? [y/N] "; kill_cmd=(kill-pane -t "$win_tmux") ;;
    (window) question="Kill tmux window $win_title? [y/N] "; kill_cmd=(kill-window -t "$win_tmux") ;;
    (*) return 1 ;;
  esac
  print -rn -- "$question"
  read -k 1 -s key || return 0
  [[ $key == [yY] ]] || return 0
  print
  if ! tmux_on "$win_target" $kill_cmd; then
    print -r -- "kitmux: tmux refused, press any key"
    read -k 1 -s key
  fi
}

# Scrollback key, run in an overlay: the full history of the active pane of
# the tab's tmux window, in a pager opened at the end.
scrollback_main() {
  key_context "$1" || return 1
  tmux_on "$win_target" capture-pane -p -e -J -S - -t "$win_tmux" | less -R +G
}

# Copies the copy-mode selection of pane $1 on the tab's target to the local
# clipboard and leaves copy mode. copy-selection-and-cancel makes a new buffer,
# renamed to COPY_BUFFER, read from the target and piped into the local
# clipboard tool (pbcopy on macOS, wl-copy elsewhere), then deleted. That works
# for ssh targets without OSC 52, and the user's own buffers stay as they were.
selection_to_clipboard() {
  local clipboard_cmd=wl-copy
  local -i rc
  [[ $OSTYPE == darwin* ]] && clipboard_cmd=pbcopy
  tmux_on "$win_target" send-keys -X -t "$1" copy-selection-and-cancel \; set-buffer -n $COPY_BUFFER &&
    tmux_on "$win_target" show-buffer -b $COPY_BUFFER | ${=clipboard_cmd}
  rc=$?
  tmux_on "$win_target" delete-buffer -b $COPY_BUFFER &>/dev/null
  return rc
}

# Decides what the copy key copies in a pane whose COPY_STATE fields are $1 to
# $4. Prints tmux, claude or none.
#   tmux    the pane's copy-mode selection
#   claude  Claude Code's own selection: its fullscreen mode takes the mouse, so
#           a drag selects inside Claude Code. Its native install names the
#           process after its version.
copy_source() {
  if [[ $1 == 1 ]]; then
    print tmux
  elif [[ $2 == 0 && $3 == 1 && $4 == $~CLAUDE_COMMAND ]]; then
    print claude
  else
    print none
  fi
}

# Copy key, run after kitty's own copy_to_clipboard: copies the tab's active
# pane's copy-mode selection, which a mouse drag leaves when the user's
# tmux.conf unbinds MouseDragEnd1Pane, or sends Claude Code its copy key. With
# neither it does nothing, so the clipboard keeps what kitty copied from its
# own (shift+drag) selection.
copy_main() {
  local pane
  local -a state
  key_context "$1" || return 1
  pane="=${win_session}${HELPER_SEPARATOR}${win_tmux#@}:$win_tmux"
  state=("${(@s:|:)$(tmux_on "$win_target" display-message -p -t "$pane" $COPY_STATE)}")
  case $(copy_source "${state[@]}") in
    (tmux) selection_to_clipboard "$pane" ;;
    (claude) tmux_on "$win_target" send-keys -t "$pane" -H $CLAUDE_COPY_KEY ;;
  esac
}

# Decides what the copy-last-output key does with the cursor lines of its probe
# (see copylast_main). $1 is where previous-prompt -o landed, the output start
# of the last command that has one; $2 the first prompt mark after it; $3 the
# first prompt mark after that; $4 where previous-prompt and next-prompt from $1
# land, which is $1 itself when its line has a prompt mark too; $5 the bottom
# line, where the searches start. Prints ok, nomarks or empty.
#   $4 == $1   the output mark shares a prompt's line: the command printed
#   != $5      nothing, and the shell (bash) did not clear the line before
#              drawing the next prompt. Later empty Enters leave no output mark.
#   $2 <= $1   nothing found: no marks, or only the prompt of a running command
#   $3 != $2   the prompt after $1 is not the current one, so the last command
#              printed nothing (drawing the next prompt drops its output mark
#              in zsh and fish) and $1 belongs to an earlier command
copylast_verdict() {
  local -i out=$1 next=$2 after=$3 out_prompt=$4 bottom=$5
  if (( out_prompt == out && out != bottom )); then
    print empty
  elif (( next <= out )); then
    print nomarks
  elif (( after != next )); then
    print empty
  else
    print ok
  fi
}

# Copy-last-output key: copies the output of the last command of the tab's
# active pane, found through the OSC 133 marks the shell emits inside tmux. The
# probe enters copy mode and prints the cursor line after previous-prompt -o and
# two next-prompt, after previous-prompt and next-prompt from that output start,
# and at the bottom, then copylast_verdict decides. Only an ok verdict selects
# from the output start to the line above the next prompt and copies it with
# selection_to_clipboard. Otherwise copy mode is left and display-message says
# why. A pane already in copy mode is reset first. Like _split, it names the
# tab's own helper session.
copylast_main() {
  local pane out verdict message client
  local -i rc
  local -a lines
  key_context "$1" || return 1
  pane="=${win_session}${HELPER_SEPARATOR}${win_tmux#@}:$win_tmux"
  tmux_on "$win_target" send-keys -X -t "$pane" cancel &>/dev/null
  out=$(tmux_on "$win_target" copy-mode -t "$pane" \; \
    send-keys -X -t "$pane" history-bottom \; \
    send-keys -X -t "$pane" previous-prompt -o \; display-message -p -t "$pane" $COPYLAST_POS \; \
    send-keys -X -t "$pane" next-prompt \; display-message -p -t "$pane" $COPYLAST_POS \; \
    send-keys -X -t "$pane" next-prompt \; display-message -p -t "$pane" $COPYLAST_POS \; \
    send-keys -X -t "$pane" history-bottom \; send-keys -X -t "$pane" previous-prompt -o \; \
    send-keys -X -t "$pane" previous-prompt \; \
    send-keys -X -t "$pane" next-prompt \; display-message -p -t "$pane" $COPYLAST_POS \; \
    send-keys -X -t "$pane" history-bottom \; display-message -p -t "$pane" $COPYLAST_POS 2>&1)
  rc=$?
  lines=("${(@f)out}")
  if (( rc == 0 && $#lines == 5 )) && [[ ${(j::)lines} == <-> ]]; then
    verdict=$(copylast_verdict $lines)
  else
    verdict=failed
  fi
  case $verdict in
    (ok)
      tmux_on "$win_target" send-keys -X -t "$pane" history-bottom \; \
        send-keys -X -t "$pane" previous-prompt -o \; send-keys -X -t "$pane" begin-selection \; \
        send-keys -X -t "$pane" next-prompt \; send-keys -X -t "$pane" cursor-up \; \
        send-keys -X -t "$pane" end-of-line && selection_to_clipboard "$pane" && return
      message=$COPYLAST_FAILED ;;
    (nomarks) message=$COPYLAST_NO_MARKS ;;
    (empty) message=$COPYLAST_NO_OUTPUT ;;
    (*) message=$COPYLAST_FAILED ;;
  esac
  tmux_on "$win_target" send-keys -X -t "$pane" cancel &>/dev/null
  # Run from outside a client, display-message needs the tab's client named.
  client=$(tmux_on "$win_target" list-clients -t "=${win_session}${HELPER_SEPARATOR}${win_tmux#@}:" -F '#{client_name}' 2>/dev/null)
  tmux_on "$win_target" display-message -c "${client%%$'\n'*}" "$message"
}

# --- launcher -----------------------------------------------------------------

# Prints the usage text.
usage() {
  print -r -- "usage: kitmux [-s SESSION] [TARGET [SSH OPTION...]...]

Opens a kitty OS window with one tab per window of tmux session SESSION
(default: $DEFAULT_SESSION) on each TARGET. A TARGET is '$LOCAL_TARGET' or an ssh
destination; no TARGET means '$LOCAL_TARGET'. Options after an ssh destination go
to every ssh kitmux runs for it, e.g. 'kitmux devbox -p 2222 -J bastion'. Every
run opens its own OS window in one shared kitty process. When a window for
SESSION on the TARGETs is already open, kitmux focuses it instead.

Environment: KITMUX_SSH overrides the ssh command, e.g. \"ssh -F /path/config\"."
}

# Checks that target $1 is reachable and runs a supported tmux. Dies with a
# message otherwise. Also opens the ssh master the later commands reuse.
check_target() {
  local target=$1 version
  version=$(tmux_on "$target" -V 2>&1) || die "$target: cannot run tmux: $version"
  tmux_version_ok "$version" ||
    die "$target: tmux $MIN_TMUX_MAJOR.$MIN_TMUX_MINOR or newer is required, found '$version'"
}

# Makes sure session $2 exists on target $1, restoring a cold server, and
# clears helper sessions of an earlier run. Dies with a message on failure.
start_target() {
  local target=$1 session=$2 report
  local -a lines
  report=$(connect_target "$target" start "$session" 2>&1) || die "$target: $report"
  lines=("${(@f)report}")
  [[ $lines[-1] == ok ]] || die "$target: ${lines[-1]#error }"
}

# Sets runtime_dir and kitty_sock to the stable per-user location shared by every
# run, and creates the dir. Dies when it cannot be used.
init_runtime_dir() {
  local base=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
  typeset -g runtime_dir=${base%/}/$RUNTIME_PARENT
  mkdir -p -m 700 -- $runtime_dir && [[ -O $runtime_dir ]] || die "cannot use runtime dir $runtime_dir"
  (( ${#runtime_dir} + 1 + ${#SOCKET_NAME} < SOCKET_PATH_MAX )) ||
    die "runtime dir $runtime_dir is too long for a unix socket path"
  typeset -g kitty_sock=unix:$runtime_dir/$SOCKET_NAME
}

# Looks for a window of a running kitmux that already shows session $1 of one
# of the targets $2... in the shared kitty process. Focuses it and succeeds when
# it covers every target, dies when it covers only some (their helper sessions
# would clash), fails when there is none.
focus_open_window() {
  local session=$1 target line run t s tab first=
  local -a open_lines found
  shift
  for line in "${(@f)$(kt ls 2>/dev/null | jq -r "$JQ_OPEN_TABS")}"; do
    [[ -n $line ]] || continue
    IFS=' ' read -r run t s tab <<< "$line"
    # A run that died leaves tabs nobody manages; they do not count.
    [[ $run == <1-> ]] && kill -0 $run 2>/dev/null && open_lines+=("$t $s $tab")
  done
  for target in "$@"; do
    find_open_tab $session $target "${open_lines[@]}" || continue
    found+=($target)
    [[ -n $first ]] || first=$REPLY
  done
  (( $#found )) || return 1
  (( $#found == $# )) ||
    die "session $session is already open for ${(j:, :)found}, so it cannot also open for ${(j:, :)@}"
  kt focus-tab --match "id:$first"
  print -r -- "kitmux: session $session is already open, focused its window"
}

# Entry point of `kitmux [-s SESSION] [TARGET...]`: validates, focuses the open
# window when this session is already mirrored, otherwise prepares every target,
# starts the bridge in the background and returns once its OS window exists.
launcher_main() {
  local session=$DEFAULT_SESSION target log_dir tool
  local -a targets bridge_args
  local -aU unique_targets
  local -i bridge_pid waited=0
  while (( $# )); do
    case $1 in
      (-h|--help) usage; return 0 ;;
      (-s) (( $# >= 2 )) || die "-s needs a session name"; session=$2; shift 2 ;;
      (-s?*) session=${1#-s}; shift ;;
      (--) shift; break ;;
      (-*) die "unknown option '$1' (see kitmux --help)" ;;
      (*) break ;;
    esac
  done
  parse_targets "$@" || die "$REPLY"
  targets=("${reply[@]}")
  (( $#targets )) || targets=($LOCAL_TARGET)
  valid_session "$session" ||
    die "invalid session name '$session': use 1-32 of A-Z a-z 0-9 _ . -"
  for target in $targets; do
    valid_target "$target" ||
      die "invalid target ${(q)target}: it must not start with '-' or contain spaces or control characters"
  done
  unique_targets=($targets)
  (( $#unique_targets == $#targets )) || die "a target is listed twice"
  for tool in kitty kitten jq; do
    (( $+commands[$tool] )) || die "$tool not found in PATH"
  done
  [[ -r $OVERLAY_CONF ]] || die "missing $OVERLAY_CONF"
  init_runtime_dir

  # Before anything touches the targets: starting one removes the helper
  # sessions of its session, which the open window's tabs are attached to.
  focus_open_window $session $targets && return 0

  init_target_env
  # Check every target before touching any, so a bad one leaves nothing behind.
  for target in $targets; do
    check_target "$target"
  done
  for target in $targets; do
    start_target "$target" "$session"
  done

  log_dir=${XDG_STATE_HOME:-$HOME/.local/state}/kitmux
  mkdir -p -- $log_dir || die "cannot create $log_dir"

  for target in $targets; do
    bridge_args+=($target "$target_ssh[$target]")
  done
  $SELF _bridge $runtime_dir $session $bridge_args </dev/null >>$log_dir/kitmux.log 2>&1 &!
  bridge_pid=$!
  until os_window_of_run $bridge_pid; do
    kill -0 $bridge_pid 2>/dev/null || die "kitty did not start, see $log_dir/kitmux.log"
    (( (waited += TICK_CS) <= (KITTY_START_TIMEOUT + 1) * 100 )) ||
      die "timed out waiting for kitty, see $log_dir/kitmux.log"
    zselect -t $TICK_CS
  done
  return 0
}

# Dispatches on the first argument; names starting with _ are internal.
main() {
  # Started from inside tmux, $TMUX would point every local tmux command at
  # that client's server and session. kitmux always uses the default socket.
  unset TMUX TMUX_PANE
  case ${1:-} in
    (_bridge) shift; bridge_main "$@" ;;
    (_hold) hold_main "$2" ;;
    (_tab) shift; tab_main "$@" ;;
    (_newtab) newtab_main "$2" ;;
    (_split) split_main "$2" "$3" ;;
    (_pane) pane_main "$2" "$3" ;;
    (_confirm) confirm_main "$2" "$3" ;;
    (_scrollback) scrollback_main "$2" ;;
    (_copy) copy_main "$2" ;;
    (_copylast) copylast_main "$2" ;;
    (*) launcher_main "$@" ;;
  esac
}

# Run only when executed; the unit tests source this file for its functions.
# The explicit exit keeps zsh from reading on in a file that was edited or
# updated while a long-lived bridge was running from it.
if [[ $ZSH_EVAL_CONTEXT == toplevel ]]; then
  main "$@"
  exit
fi
